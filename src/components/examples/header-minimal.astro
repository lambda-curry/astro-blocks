---
import HeaderMinimal from "../blocks/HeaderMinimal.astro";
import HeroTypographic from "../blocks/HeroTypographic.astro";
---

<HeaderMinimal
  brand="Quarry Bread"
  links={[
    { label: "Menu", href: "/menu" },
    { label: "Wholesale", href: "/wholesale" },
    { label: "Visit", href: "/visit" },
  ]}
  action={{ label: "Order for Saturday", href: "/order" }}
/>
<main style="inline-size: min(72rem, 100% - 2.5rem); margin-inline: auto;">
  <HeroTypographic
    title="Slow-fermented bread, baked before the street wakes up"
    emphasis="before the street wakes up"
    actions={[{ label: "See this week's bakes", href: "/menu" }]}
    facts={["14 Mill Lane", "Wed–Sun · 7–2", "Since 2016"]}
  />
</main>
