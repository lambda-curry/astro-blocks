---
// Exact source, set plainly. The copy button appears only when JavaScript can run it.
interface Props {
  code: string;
  label: string;
  /** Collapse long code behind a disclosure. */
  collapsed?: boolean;
}

const { code, label, collapsed = false } = Astro.props;
const lines = code.trimEnd().split("\n").length;
---

<figure class="code-block" data-code-block>
  <figcaption>
    <span class="label">{label}</span>
    <button type="button" class="copy" hidden data-copy>Copy</button>
  </figcaption>
  {
    collapsed ? (
      <details>
        <summary>Show {lines} lines</summary>
        <pre><code>{code.trimEnd()}</code></pre>
      </details>
    ) : (
      <pre><code>{code.trimEnd()}</code></pre>
    )
  }
</figure>

<script>
  for (const block of document.querySelectorAll<HTMLElement>("[data-code-block]")) {
    const button = block.querySelector<HTMLButtonElement>("[data-copy]");
    const code = block.querySelector("code");
    if (!button || !code || !navigator.clipboard) continue;
    button.hidden = false;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
        button.textContent = "Copied";
      } catch {
        button.textContent = "Select the code to copy";
      }
      setTimeout(() => (button.textContent = "Copy"), 2400);
    });
  }
</script>

<style>
  .code-block {
    min-inline-size: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--color-text) 12%, transparent);
    border-radius: var(--radius-lg);
    background: color-mix(in oklab, var(--color-surface) 55%, var(--color-bg));
  }
  figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-block-size: 2.75rem;
    padding-inline: 1rem 0.375rem;
    border-block-end: 1px solid color-mix(in oklab, var(--color-text) 10%, transparent);
    color: var(--color-muted);
    font-size: var(--step--1);
    font-weight: var(--weight-action);
  }
  .copy {
    min-block-size: 2.25rem;
    padding-inline: 0.75rem;
    border: 1px solid color-mix(in oklab, var(--color-text) 18%, transparent);
    border-radius: var(--radius-sm);
    background: var(--color-bg);
    color: var(--color-text);
    font: inherit;
    cursor: pointer;
  }
  .code-block pre {
    max-block-size: 34rem;
    margin: 0;
    padding: 1rem 1.25rem 1.25rem;
    overflow: auto;
    font: 0.8125rem / 1.65 ui-monospace, "SF Mono", "Cascadia Code", Menlo, Consolas, monospace;
    background: none;
    tab-size: 2;
  }
  details summary {
    min-block-size: 44px;
    padding: 0.75rem 1.25rem;
    color: var(--color-link);
    font-size: var(--step--1);
    font-weight: var(--weight-action);
    cursor: pointer;
  }
</style>
