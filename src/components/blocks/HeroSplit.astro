---
// Astro Blocks — hero-split — MIT — https://github.com/lambda-curry/astro-blocks
import Button from "../ui/Button.astro";

interface Action {
  label: string;
  href: string;
  variant?: "solid" | "outline" | "quiet";
}
interface Props {
  title: string;
  lede?: string;
  /** The first action is the primary one; keep it to one or two. */
  actions?: Action[];
  /** One real image. Use the media slot instead for a picture, video or SVG artwork. */
  image?: { src: string; alt: string; width?: number; height?: number };
  mediaSide?: "start" | "end";
  /** CSS aspect-ratio of the media frame on wide screens. */
  ratio?: string;
  /** Vertical alignment of the copy against the media. */
  align?: "center" | "end";
  headingLevel?: 1 | 2;
}

const {
  title,
  lede,
  actions = [],
  image,
  mediaSide = "end",
  ratio = "4 / 5",
  align = "center",
  headingLevel = 1,
} = Astro.props;
const Heading = `h${headingLevel}` as "h1" | "h2";
const hasMedia = Boolean(image) || Astro.slots.has("media");
---

<section class:list={["hero-split", `media-${mediaSide}`, `align-${align}`, { "has-media": hasMedia }]} style={`--_ratio: ${ratio}`}>
  <div class="inner">
    <div class="copy">
      <Heading class="title">{title}</Heading>
      {lede && <p class="lede">{lede}</p>}
      <slot />
      {
        actions.length > 0 && (
          <div class="actions">
            {actions.map(({ label, href, variant }, index) => (
              <Button href={href} size="lg" variant={variant ?? (index === 0 ? "solid" : "quiet")}>
                {label}
              </Button>
            ))}
          </div>
        )
      }
      {Astro.slots.has("meta") && <div class="meta"><slot name="meta" /></div>}
    </div>
    {
      hasMedia && (
        <div class="media">
          <slot name="media">
            {image && (
              <img src={image.src} alt={image.alt} width={image.width} height={image.height} loading="eager" fetchpriority="high" decoding="async" />
            )}
          </slot>
        </div>
      )
    }
  </div>
</section>

<style>
  .hero-split {
    container-type: inline-size;
    padding-block: clamp(2rem, 6vw, 6rem);
    color: var(--color-text, #1b1f22);
  }
  .inner {
    display: grid;
    gap: clamp(2rem, 5cqi, 4.5rem);
  }
  .copy {
    min-inline-size: 0;
  }
  .title {
    margin: 0;
    max-inline-size: 15ch;
    font-family: var(--font-display, system-ui, sans-serif);
    font-size: clamp(2.4rem, 1.3rem + 4.6cqi, 5.4rem);
    font-weight: var(--weight-display, 650);
    letter-spacing: var(--tracking-display, -0.022em);
    line-height: 1;
    text-wrap: balance;
  }
  .lede {
    margin: 1.25rem 0 0;
    max-inline-size: 36ch;
    color: var(--color-muted, #555c62);
    font-size: var(--step-1, clamp(1.2rem, 1.1rem + 0.5vw, 1.5rem));
    line-height: 1.45;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-block-start: 2rem;
  }
  .meta {
    margin-block-start: 2.25rem;
    padding-block-start: 1rem;
    border-block-start: 1px solid color-mix(in oklab, currentColor 14%, transparent);
    color: var(--color-muted, #555c62);
    font-size: var(--step--1, clamp(0.875rem, 0.84rem + 0.16vw, 0.95rem));
  }
  .meta > :global(:first-child) {
    margin-block-start: 0;
  }
  .meta > :global(:last-child) {
    margin-block-end: 0;
  }
  .media {
    overflow: clip;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg, 1rem);
    background: var(--color-surface, #f3f4f1);
  }
  .media > :global(*) {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  @container (min-width: 52rem) {
    .has-media .inner {
      grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
      align-items: center;
    }
    .align-end .inner {
      align-items: end;
    }
    .media-start .media {
      order: -1;
    }
    .media {
      aspect-ratio: var(--_ratio, 4 / 5);
    }
  }
</style>
