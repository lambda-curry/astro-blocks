---
// Astro Blocks — steps-numbered — MIT — https://github.com/lambda-curry/astro-blocks
interface Step {
  title: string;
  text: string;
  /** A short fact for this step, such as its duration or who does it. */
  detail?: string;
}
interface Props {
  title?: string;
  intro?: string;
  /** Two to five steps of a real sequence. Numbers carry meaning here, so don't use this for unordered features. */
  steps: Step[];
  /** row: steps side by side on wide screens. list: one step per line, for longer step text. */
  layout?: "row" | "list";
  headingLevel?: 2 | 3;
}

const { title, intro, steps, layout = "row", headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
const StepHeading = `h${headingLevel + 1}` as "h3" | "h4";
---

<section class:list={["steps-numbered", `layout-${layout}`]}>
  {
    (title || intro) && (
      <div class="intro">
        {title && <Heading class="title">{title}</Heading>}
        {intro && <p>{intro}</p>}
      </div>
    )
  }
  <ol class="steps">
    {
      steps.map((step) => (
        <li class="step">
          <StepHeading class="step-title">{step.title}</StepHeading>
          <p class="step-text">{step.text}</p>
          {step.detail && <p class="step-detail">{step.detail}</p>}
        </li>
      ))
    }
  </ol>
</section>

<style>
  .steps-numbered {
    container-type: inline-size;
    padding-block: var(--section-gap, clamp(3rem, 8vw, 7rem));
    color: var(--color-text, #1b1f22);
  }
  .intro {
    max-inline-size: 40rem;
    margin-block-end: clamp(2rem, 5cqi, 3.5rem);
  }
  .title {
    margin: 0;
    font-family: var(--font-display, system-ui, sans-serif);
    font-size: var(--step-3, clamp(1.75rem, 1.35rem + 1.8vw, 2.75rem));
    font-weight: var(--weight-display, 650);
    letter-spacing: var(--tracking-display, -0.022em);
    line-height: var(--leading-display, 1.08);
  }
  .intro p {
    margin: 1rem 0 0;
    color: var(--color-muted, #555c62);
    font-size: var(--step-1, clamp(1.2rem, 1.1rem + 0.5vw, 1.5rem));
    line-height: 1.45;
  }
  .steps {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }
  .step {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    column-gap: 1rem;
    padding-block: 1.5rem;
    border-block-start: 1px solid color-mix(in oklab, currentColor 16%, transparent);
    counter-increment: step;
  }
  .step::before {
    content: counter(step);
    content: counter(step) / "";
    grid-row: span 3;
    color: var(--color-accent, #1f4f5f);
    font-family: var(--font-display, system-ui, sans-serif);
    font-size: var(--step-3, clamp(1.75rem, 1.35rem + 1.8vw, 2.75rem));
    font-variant-numeric: tabular-nums lining-nums;
    font-weight: var(--weight-display, 650);
    line-height: 0.9;
  }
  .step-title {
    margin: 0;
    font-family: var(--font-display, system-ui, sans-serif);
    font-size: var(--step-1, clamp(1.2rem, 1.1rem + 0.5vw, 1.5rem));
    font-weight: var(--weight-display, 650);
    letter-spacing: var(--tracking-display, -0.022em);
    line-height: 1.2;
  }
  .step-text {
    margin: 0.5rem 0 0;
    max-inline-size: 52ch;
    color: var(--color-muted, #555c62);
  }
  .step-detail {
    margin: 0.75rem 0 0;
    font-size: var(--step--1, clamp(0.875rem, 0.84rem + 0.16vw, 0.95rem));
    font-weight: var(--weight-action, 600);
  }
  @container (min-width: 50rem) {
    .layout-row .steps {
      grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
      gap: 0 clamp(1.5rem, 3cqi, 3rem);
    }
    .layout-row .step {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto 1fr auto;
      padding-block: 1.25rem 0;
      border-block-start-width: 2px;
      border-block-start-color: currentColor;
    }
    .layout-row .step::before {
      grid-row: auto;
      margin-block-end: 1.75rem;
      font-size: var(--step-5, clamp(2.6rem, 1.7rem + 4vw, 5rem));
    }
    .layout-list .step {
      grid-template-columns: 5rem minmax(0, 1fr) minmax(0, 1.2fr);
      column-gap: 2rem;
      padding-block: 2rem;
    }
    .layout-list .step::before {
      grid-row: span 2;
      font-size: var(--step-4, clamp(2.15rem, 1.5rem + 2.8vw, 3.6rem));
    }
    .layout-list .step-text {
      grid-column: 3;
      grid-row: 1 / span 2;
      margin: 0;
    }
  }
</style>
