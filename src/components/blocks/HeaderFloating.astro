---
// Astro Blocks — header-floating — MIT — https://github.com/lambda-curry/astro-blocks
import Button from "../ui/Button.astro";

interface Link {
  label: string;
  href: string;
}
interface Props {
  /** Site name. Used as the home link text, or as the logo's alt text. */
  brand: string;
  homeHref?: string;
  logo?: { src: string; alt?: string; width?: number; height?: number };
  links?: Link[];
  /** One primary action. It sits in the bar and moves into the menu on the narrowest screens. */
  action?: Link;
  /** Keep the bar pinned below the top edge while scrolling. */
  sticky?: boolean;
  /** Unique id for the narrow-screen menu when a page has two headers. */
  menuId?: string;
}

const { brand, homeHref = "/", logo, links = [], action, sticky = true, menuId = "site-menu" } = Astro.props;
const trim = (path: string) => path.replace(/\/$/, "") || "/";
const here = trim(Astro.url.pathname);
const isCurrent = (href: string) => (href.startsWith("/") && !href.startsWith("//") && trim(href) === here ? "page" : undefined);
---

<header class:list={["header-floating", { sticky }]}>
  <div class="bar">
    <a class="brand" href={homeHref}>
      {logo ? <img src={logo.src} alt={logo.alt ?? brand} width={logo.width} height={logo.height} /> : brand}
    </a>
    {
      links.length > 0 && (
        <nav aria-label="Primary">
          <button class="toggle" type="button" popovertarget={menuId}>
            Menu
          </button>
          <ul class="links" id={menuId} popover>
            {links.map(({ label, href }) => (
              <li>
                <a class="nav-link" href={href} aria-current={isCurrent(href)}>
                  {label}
                </a>
              </li>
            ))}
            {action && (
              <li class="menu-action">
                <Button href={action.href}>{action.label}</Button>
              </li>
            )}
          </ul>
        </nav>
      )
    }
    {action && <Button class="action" href={action.href}>{action.label}</Button>}
  </div>
</header>

<style>
  .header-floating {
    container-type: inline-size;
    position: relative;
    z-index: 30;
    padding: 0.75rem clamp(0.75rem, 2.5vw, 1.5rem);
  }
  .sticky {
    position: sticky;
    inset-block-start: 0;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 0.5rem 1.25rem;
    max-inline-size: var(--width-content, 72rem);
    min-block-size: 3.5rem;
    margin-inline: auto;
    padding: 0.375rem 0.375rem 0.375rem 1.25rem;
    border: 1px solid color-mix(in oklab, var(--color-text, #1b1f22) 11%, transparent);
    border-radius: calc(var(--radius-lg, 1rem) + 0.375rem);
    background: color-mix(in oklab, var(--color-bg, #ffffff) 84%, transparent);
    color: var(--color-text, #1b1f22);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.04),
      0 14px 36px -22px rgb(0 0 0 / 0.32);
    backdrop-filter: saturate(1.5) blur(14px);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    margin-inline-end: auto;
    color: inherit;
    font-family: var(--font-display, system-ui, sans-serif);
    font-size: var(--step-1, clamp(1.2rem, 1.1rem + 0.5vw, 1.5rem));
    font-weight: var(--weight-display, 650);
    letter-spacing: var(--tracking-display, -0.022em);
    line-height: 1;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .brand img {
    display: block;
    max-block-size: 2rem;
    inline-size: auto;
  }
  nav {
    display: flex;
    align-items: center;
  }
  .toggle {
    min-block-size: 44px;
    padding-inline: 1rem;
    border: 1px solid color-mix(in oklab, currentColor 22%, transparent);
    border-radius: var(--radius-sm, 0.375rem);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: var(--step--1, clamp(0.875rem, 0.84rem + 0.16vw, 0.95rem));
    font-weight: var(--weight-action, 600);
    cursor: pointer;
  }
  .links {
    list-style: none;
  }
  .nav-link {
    display: flex;
    align-items: center;
    min-block-size: 44px;
    padding-inline: 0.75rem;
    border-radius: var(--radius-sm, 0.375rem);
    color: color-mix(in oklab, currentColor 78%, transparent);
    font-size: var(--step--1, clamp(0.875rem, 0.84rem + 0.16vw, 0.95rem));
    text-decoration: none;
  }
  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: inherit;
  }
  .nav-link[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--color-accent, #1f4f5f);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }
  .links:popover-open {
    position: fixed;
    inset: 5rem 0.75rem auto;
    display: grid;
    gap: 0.125rem;
    inline-size: auto;
    margin: 0;
    padding: 0.5rem;
    border: 1px solid color-mix(in oklab, var(--color-text, #1b1f22) 12%, transparent);
    border-radius: var(--radius-lg, 1rem);
    background: var(--color-bg, #ffffff);
    color: var(--color-text, #1b1f22);
    box-shadow: 0 24px 60px -18px rgb(0 0 0 / 0.35);
    opacity: 1;
    translate: 0 0;
    transition:
      opacity var(--duration, 160ms) var(--ease, cubic-bezier(0.2, 0.7, 0.2, 1)),
      translate var(--duration, 160ms) var(--ease, cubic-bezier(0.2, 0.7, 0.2, 1));
  }
  @starting-style {
    .links:popover-open {
      opacity: 0;
      translate: 0 -0.5rem;
    }
  }
  .links:popover-open .nav-link {
    font-size: var(--step-0, clamp(1rem, 0.96rem + 0.2vw, 1.125rem));
    padding-inline: 1rem;
  }
  .links::backdrop {
    background: transparent;
  }
  .menu-action {
    display: none;
  }
  .action {
    white-space: nowrap;
  }
  @container (max-width: 29.999rem) {
    .bar > .action {
      display: none;
    }
    .links:popover-open .menu-action {
      display: grid;
      margin-block-start: 0.5rem;
    }
  }
  @container (min-width: 30rem) and (max-width: 45.999rem) {
    .action {
      min-block-size: 44px;
      padding-inline: 0.9rem;
      font-size: var(--step--1, clamp(0.875rem, 0.84rem + 0.16vw, 0.95rem));
    }
  }
  :focus-visible {
    outline: 3px solid var(--color-focus, #1f4f5f);
    outline-offset: 2px;
  }
  @container (min-width: 46rem) {
    .bar {
      gap: 0.5rem 1.5rem;
    }
    .toggle {
      display: none;
    }
    .links {
      position: static;
      display: flex;
      gap: 0.125rem;
      inline-size: auto;
      block-size: auto;
      margin: 0;
      padding: 0;
      overflow: visible;
      border: 0;
      background: none;
      color: inherit;
    }
  }
</style>
