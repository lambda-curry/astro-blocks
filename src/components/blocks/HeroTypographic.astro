---
// Astro Blocks — hero-typographic — MIT — https://github.com/lambda-curry/astro-blocks
import Button from "../ui/Button.astro";

interface Action {
  label: string;
  href: string;
  variant?: "solid" | "outline" | "quiet";
}
interface Props {
  /** One statement sentence. The headline is the hero, so keep it under about 14 words. */
  title: string;
  /** A word or phrase from the title to set in the accent color. */
  emphasis?: string;
  lede?: string;
  actions?: Action[];
  /** Two to four short facts shown on a ruled line, such as place, hours or founding year. */
  facts?: string[];
  align?: "start" | "center";
  headingLevel?: 1 | 2;
}

const { title, emphasis, lede, actions = [], facts = [], align = "start", headingLevel = 1 } = Astro.props;
const Heading = `h${headingLevel}` as "h1" | "h2";
const at = emphasis ? title.indexOf(emphasis) : -1;
const [before, after] = at >= 0 && emphasis ? [title.slice(0, at), title.slice(at + emphasis.length)] : [title, ""];
---

<section class:list={["hero-typographic", `align-${align}`]}>
  <div class="inner">
    <Heading class="title">
      {before}{at >= 0 && <em>{emphasis}</em>}{after}
    </Heading>
    {lede && <p class="lede">{lede}</p>}
    <slot />
    {
      actions.length > 0 && (
        <div class="actions">
          {actions.map(({ label, href, variant }, index) => (
            <Button href={href} size="lg" variant={variant ?? (index === 0 ? "solid" : "quiet")}>
              {label}
            </Button>
          ))}
        </div>
      )
    }
    {
      facts.length > 0 && (
        <ul class="facts">
          {facts.map((fact) => (
            <li>{fact}</li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .hero-typographic {
    container-type: inline-size;
    padding-block: clamp(2.5rem, 8vw, 7rem) clamp(2.5rem, 6vw, 5rem);
    color: var(--color-text, #1b1f22);
  }
  .inner {
    display: grid;
    justify-items: start;
  }
  .align-center .inner {
    justify-items: center;
    text-align: center;
  }
  .title {
    margin: 0;
    max-inline-size: 17ch;
    font-family: var(--font-display, system-ui, sans-serif);
    font-size: clamp(2.6rem, 0.9rem + 7.4cqi, 8.25rem);
    font-weight: var(--weight-display, 650);
    letter-spacing: var(--tracking-display, -0.022em);
    line-height: 0.98;
    text-wrap: balance;
  }
  .title em {
    color: var(--color-accent, #1f4f5f);
    font-style: inherit;
  }
  .lede {
    margin: clamp(1.25rem, 2.5cqi, 2rem) 0 0;
    max-inline-size: 42ch;
    color: var(--color-muted, #555c62);
    font-size: var(--step-1, clamp(1.2rem, 1.1rem + 0.5vw, 1.5rem));
    line-height: 1.45;
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-block-start: 2.25rem;
  }
  .align-center .actions {
    justify-content: center;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 2.5rem;
    inline-size: 100%;
    margin: clamp(3rem, 7cqi, 5.5rem) 0 0;
    padding: 1rem 0 0;
    border-block-start: 1px solid color-mix(in oklab, currentColor 16%, transparent);
    color: var(--color-muted, #555c62);
    font-size: var(--step--1, clamp(0.875rem, 0.84rem + 0.16vw, 0.95rem));
    list-style: none;
    text-align: start;
  }
  .align-center .facts {
    justify-content: center;
  }
</style>
