---
// Astro Blocks — header-transparent — MIT — https://github.com/lambda-curry/astro-blocks
import Button from "../ui/Button.astro";

interface Link {
  label: string;
  href: string;
}
interface Props {
  /** Site name. Used as the home link text, or as the logo's alt text. */
  brand: string;
  homeHref?: string;
  logo?: { src: string; alt?: string; width?: number; height?: number };
  links?: Link[];
  action?: Link;
  /** light: white text for dark imagery. dark: text color for light imagery. */
  tone?: "light" | "dark";
  /** Pin the header and fade in a solid surface while scrolling, where the browser supports scroll-driven animation. */
  solidOnScroll?: boolean;
  /** Unique id for the narrow-screen menu when a page has two headers. */
  menuId?: string;
}

const { brand, homeHref = "/", logo, links = [], action, tone = "light", solidOnScroll = true, menuId = "site-menu" } = Astro.props;
const trim = (path: string) => path.replace(/\/$/, "") || "/";
const here = trim(Astro.url.pathname);
const isCurrent = (href: string) => (href.startsWith("/") && !href.startsWith("//") && trim(href) === here ? "page" : undefined);
---

<header class:list={["header-transparent", `tone-${tone}`, { "solid-on-scroll": solidOnScroll }]}>
  <div class="row">
    <a class="brand" href={homeHref}>
      {logo ? <img src={logo.src} alt={logo.alt ?? brand} width={logo.width} height={logo.height} /> : brand}
    </a>
    {
      links.length > 0 && (
        <nav aria-label="Primary">
          <button class="toggle" type="button" popovertarget={menuId}>
            Menu
          </button>
          <ul class="links" id={menuId} popover>
            {links.map(({ label, href }) => (
              <li>
                <a class="nav-link" href={href} aria-current={isCurrent(href)}>
                  {label}
                </a>
              </li>
            ))}
            {action && (
              <li class="menu-action">
                <Button href={action.href}>{action.label}</Button>
              </li>
            )}
          </ul>
        </nav>
      )
    }
    {action && <Button class="action" variant="outline" href={action.href}>{action.label}</Button>}
  </div>
</header>

<style>
  .header-transparent {
    --_ink: #ffffff;
    --color-focus: var(--_ink);
    container-type: inline-size;
    position: absolute;
    inset: 0 0 auto;
    z-index: 30;
    color: var(--_ink);
  }
  .tone-light {
    background: linear-gradient(to bottom, rgb(0 0 0 / 0.42), transparent);
  }
  .tone-dark {
    --_ink: var(--color-text, #1b1f22);
  }
  .row {
    display: flex;
    align-items: center;
    gap: 0.5rem 1.5rem;
    inline-size: min(var(--width-content, 72rem), 100% - 2 * var(--space-gutter, clamp(1.25rem, 4vw, 4rem)));
    min-block-size: 4.5rem;
    margin-inline: auto;
    padding-block: 0.75rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    margin-inline-end: auto;
    color: inherit;
    font-family: var(--font-display, system-ui, sans-serif);
    font-size: var(--step-1, clamp(1.2rem, 1.1rem + 0.5vw, 1.5rem));
    font-weight: var(--weight-display, 650);
    letter-spacing: var(--tracking-display, -0.022em);
    line-height: 1;
    text-decoration: none;
  }
  .brand img {
    display: block;
    max-block-size: 2.25rem;
    inline-size: auto;
  }
  nav {
    display: flex;
    align-items: center;
  }
  .toggle {
    min-block-size: 44px;
    padding-inline: 1rem;
    border: 1px solid color-mix(in oklab, currentColor 45%, transparent);
    border-radius: var(--radius-sm, 0.375rem);
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: var(--step--1, clamp(0.875rem, 0.84rem + 0.16vw, 0.95rem));
    font-weight: var(--weight-action, 600);
    cursor: pointer;
  }
  .links {
    list-style: none;
  }
  .nav-link {
    display: flex;
    align-items: center;
    min-block-size: 44px;
    padding-inline: 0.75rem;
    color: inherit;
    font-size: var(--step--1, clamp(0.875rem, 0.84rem + 0.16vw, 0.95rem));
    font-weight: var(--weight-action, 600);
    text-decoration: none;
  }
  .nav-link:hover,
  .nav-link[aria-current="page"] {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.45em;
  }
  .links:popover-open {
    position: fixed;
    inset: 5rem 0.75rem auto;
    display: grid;
    gap: 0.125rem;
    inline-size: auto;
    margin: 0;
    padding: 0.5rem;
    border: 1px solid color-mix(in oklab, var(--color-text, #1b1f22) 12%, transparent);
    border-radius: var(--radius-lg, 1rem);
    background: var(--color-bg, #ffffff);
    color: var(--color-text, #1b1f22);
    box-shadow: 0 24px 60px -18px rgb(0 0 0 / 0.35);
    --color-focus: var(--color-accent, #1f4f5f);
  }
  .links:popover-open .nav-link {
    padding-inline: 1rem;
    font-size: var(--step-0, clamp(1rem, 0.96rem + 0.2vw, 1.125rem));
    font-weight: 400;
  }
  .links::backdrop {
    background: transparent;
  }
  .menu-action {
    display: none;
  }
  .action {
    white-space: nowrap;
  }
  :focus-visible {
    outline: 3px solid currentColor;
    outline-offset: 2px;
  }
  @container (max-width: 29.999rem) {
    .row > .action {
      display: none;
    }
    .links:popover-open .menu-action {
      display: grid;
      margin-block-start: 0.5rem;
    }
  }
  @container (min-width: 46rem) {
    .toggle {
      display: none;
    }
    .links {
      position: static;
      display: flex;
      gap: 0.125rem;
      inline-size: auto;
      block-size: auto;
      margin: 0;
      padding: 0;
      overflow: visible;
      border: 0;
      background: none;
      color: inherit;
    }
  }
  @supports (animation-timeline: scroll()) {
    .solid-on-scroll {
      position: fixed;
      animation: header-transparent-solid linear both;
      animation-timeline: scroll(root);
      animation-range: 0 12rem;
    }
  }
  @keyframes header-transparent-solid {
    to {
      --color-focus: var(--color-accent, #1f4f5f);
      background: color-mix(in oklab, var(--color-bg, #ffffff) 92%, transparent);
      color: var(--color-text, #1b1f22);
      box-shadow: 0 1px 0 color-mix(in oklab, var(--color-text, #1b1f22) 12%, transparent);
      backdrop-filter: blur(12px);
    }
  }
</style>
