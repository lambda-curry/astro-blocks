{
  "name": "astro-blocks",
  "version": "0.1.2",
  "private": true,
  "description": "Open-source, Astro-first, shadcn-compatible source registry of polished website blocks.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/build-registry.mjs && astro build",
    "registry": "node scripts/build-registry.mjs",
    "check": "node scripts/build-registry.mjs --check && astro check",
    "validate": "shadcn registry validate registry.json",
    "shots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/node": "11.1.14",
    "astro": "7.3.2",
    "playwright-core": "1.65.1",
    "shadcn": "4.23.1",
    "typescript": "6.0.3"
  }
}
